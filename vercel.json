{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "ignoreCommand": "bash scripts/vercel-ignore-build.sh",
  "git": {
    "deploymentEnabled": {
      "mobile-viz-sweep": false
    }
  },
  "routes": [
    {
      "src": "/(?!api/)(.*)",
      "has": [
        {
          "type": "host",
          "value": "hindsight2020.vercel.app"
        }
      ],
      "status": 308,
      "headers": {
        "Location": "https://hindsightcricket.com/$1"
      }
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.hindsightcricket.com"
        }
      ],
      "status": 308,
      "headers": {
        "Location": "https://hindsightcricket.com/$1"
      }
    },
    {
      "src": "/_og",
      "dest": "/api/og.mjs"
    },
    {
      "src": "/sitemap.xml",
      "dest": "/api/sitemap.mjs"
    },
    {
      "src": "/sitemap-pages.xml",
      "dest": "/api/sitemap.mjs?kind=pages"
    },
    {
      "src": "/sitemap-scorecards-(\\d{4}).xml",
      "dest": "/api/sitemap.mjs?kind=scorecards&year=$1"
    },
    {
      "src": "/img/([A-Za-z0-9]{6,16})\\.png",
      "dest": "/api/img.mjs?id=$1"
    },
    {
      "src": "/embed/(q|wp|recap|card)/([A-Za-z0-9]{6,16})",
      "dest": "/api/embed.mjs?kind=$1&id=$2"
    },
    {
      "src": "/mcp/?",
      "methods": ["GET"],
      "has": [{"type": "header", "key": "user-agent", "value": ".*(bot|Bot|BOT|crawler|Crawler|spider|Spider|facebookexternalhit|WhatsApp|Embedly|Preview|vkShare|Google|bing).*"}],
      "dest": "/api/meta.mjs?__path=/"
    },
    {
      "src": "/mcp/?",
      "methods": ["GET"],
      "has": [{"type": "header", "key": "accept", "value": ".*text/html.*"}],
      "status": 302,
      "headers": {"Location": "/#connector"}
    },
    {
      "src": "/mcp/?",
      "dest": "https://cricket-data-thing-672dfbacf476.herokuapp.com/mcp"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/proxy.js"
    },
    {
      "src": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(bot|Bot|BOT|crawler|Crawler|spider|Spider|facebookexternalhit|WhatsApp|Embedly|Preview|vkShare|Google|bing).*"
        }
      ],
      "dest": "/api/meta.mjs?__path=/"
    },
    {
      "src": "/(scorecard/[^/]+|scorecards|player|venue|query|rankings|links|games/[^/]+|notes(?:/[^/]+)?|g/[^/]+)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(bot|Bot|BOT|crawler|Crawler|spider|Spider|facebookexternalhit|WhatsApp|Embedly|Preview|vkShare|Google|bing).*"
        }
      ],
      "dest": "/api/meta.mjs?__path=/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "functions": {
    "api/img.mjs": {
      "includeFiles": "api/_lib/fonts/**"
    },
    "api/embed.mjs": {
      "includeFiles": "mcp_server/widget.html"
    },
    "api/meta.mjs": {
      "includeFiles": "src/components/notes/noteMarkdown.mjs"
    }
  }
}
