{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "ignoreCommand": "bash scripts/vercel-ignore-build.sh",
  "routes": [
    {
      "src": "/(?!api/)(.*)",
      "has": [
        {
          "type": "host",
          "value": "hindsight2020.vercel.app"
        }
      ],
      "status": 308,
      "headers": {
        "Location": "https://hindsightcricket.com/$1"
      }
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.hindsightcricket.com"
        }
      ],
      "status": 308,
      "headers": {
        "Location": "https://hindsightcricket.com/$1"
      }
    },
    {
      "src": "/_og",
      "dest": "/api/og.mjs"
    },
    {
      "src": "/sitemap.xml",
      "dest": "/api/sitemap.mjs"
    },
    {
      "src": "/img/([A-Za-z0-9]{6,16})\\.png",
      "dest": "/api/img.mjs?id=$1"
    },
    {
      "src": "/embed/(q|wp|recap)/([A-Za-z0-9]{6,16})",
      "dest": "/api/embed.mjs?kind=$1&id=$2"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/proxy.js"
    },
    {
      "src": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(bot|Bot|BOT|crawler|Crawler|spider|Spider|facebookexternalhit|WhatsApp|Embedly|Preview|vkShare|Google|bing).*"
        }
      ],
      "dest": "/api/meta.mjs?__path=/"
    },
    {
      "src": "/(scorecard/[^/]+|player|venue|query|rankings|games/[^/]+)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(bot|Bot|BOT|crawler|Crawler|spider|Spider|facebookexternalhit|WhatsApp|Embedly|Preview|vkShare|Google|bing).*"
        }
      ],
      "dest": "/api/meta.mjs?__path=/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "functions": {
    "api/img.mjs": {
      "includeFiles": "api/_lib/fonts/**"
    },
    "api/embed.mjs": {
      "includeFiles": "mcp_server/widget.html"
    }
  }
}
